<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:Style src="PixelToVoxelWindow.uss" />
    <ui:VisualElement name="windowRoot" class="ptv-window">
        <uie:Toolbar class="ptv-toolbar">
            <ui:Label text="Conversion Group" class="ptv-toolbar__label" />
            <ui:VisualElement name="groupFieldSlot" class="ptv-toolbar__field" />
            <ui:VisualElement class="ptv-toolbar__spacer" />
            <uie:ToolbarButton name="groupPrimaryButton" text="Save Group…" class="ptv-toolbar__button" />
            <uie:ToolbarButton name="temporaryButton" text="Reset" class="ptv-toolbar__button" />
            <ui:Label name="workingBadge" text="Working…" class="ptv-working ptv-hidden" />
        </uie:Toolbar>

        <ui:VisualElement name="temporaryNotice" class="ptv-info-strip">
            <ui:Label text="i" class="ptv-info-strip__icon" />
            <ui:Label text="Temporary group — save it only if you want to keep these settings and generation history." class="ptv-info-strip__text" />
        </ui:VisualElement>

        <ui:TwoPaneSplitView name="workspaceSplit" fixed-pane-index="0" fixed-pane-initial-dimension="340" orientation="Horizontal" class="ptv-split">
            <ui:ScrollView name="mainScroll" class="ptv-settings-scroll">
                <ui:VisualElement class="ptv-settings-content">
                    <ui:VisualElement class="ptv-heading">
                        <ui:Label text="Conversion Setup" class="ptv-heading__title" />
                        <ui:Label text="Choose source artwork, configure the generated assets, then run preflight analysis." class="ptv-heading__description" />
                    </ui:VisualElement>

                    <ui:VisualElement class="ptv-section">
                        <ui:VisualElement class="ptv-section__header">
                            <ui:Label text="Source Assets" class="ptv-section__title" />
                            <ui:Label text="PNG · Sprite · Folder" class="ptv-section__meta" />
                        </ui:VisualElement>
                        <ui:VisualElement class="ptv-section__body">
                            <ui:VisualElement name="sourcesFieldSlot" class="ptv-fields" />
                            <ui:VisualElement class="ptv-button-row">
                                <ui:Button name="addSelectionButton" text="Add Selection" />
                                <ui:Button name="clearInputsButton" text="Clear" />
                            </ui:VisualElement>
                            <ui:VisualElement name="dropZone" class="ptv-drop-zone">
                                <ui:Label text="Drag project assets here" class="ptv-drop-zone__title" />
                                <ui:Label text="Textures, sprites, and project folders are supported." class="ptv-drop-zone__hint" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="ptv-section">
                        <ui:VisualElement class="ptv-section__header">
                            <ui:Label text="Conversion Settings" class="ptv-section__title" />
                        </ui:VisualElement>
                        <ui:VisualElement class="ptv-section__body">
                            <ui:VisualElement name="presetFieldSlot" class="ptv-fields" />
                            <ui:VisualElement class="ptv-button-row">
                                <ui:Button name="applyPresetButton" text="Apply Preset" />
                                <ui:Button name="savePresetButton" text="Save Preset…" />
                            </ui:VisualElement>

                            <ui:Foldout text="Geometry" value="true" class="ptv-settings-foldout">
                                <ui:VisualElement name="geometryFields" class="ptv-fields" />
                            </ui:Foldout>
                            <ui:Foldout text="Output" value="true" class="ptv-settings-foldout">
                                <ui:VisualElement name="outputFields" class="ptv-fields" />
                                <ui:Label name="outputPathLabel" text="Output path is assigned after the first generation." class="ptv-output-path" />
                            </ui:Foldout>
                            <ui:Foldout text="Safety Limits" value="false" class="ptv-settings-foldout">
                                <ui:VisualElement name="safetyFields" class="ptv-fields" />
                                <ui:Label text="Warnings do not block generation. Review large inputs during preflight." class="ptv-inline-help" />
                            </ui:Foldout>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="preflightSection" class="ptv-section ptv-hidden">
                        <ui:VisualElement class="ptv-section__header ptv-section__header--wrap">
                            <ui:VisualElement class="ptv-section__heading">
                                <ui:Label text="Preflight Results" class="ptv-section__title" />
                                <ui:Label name="analysisSummaryLabel" class="ptv-section__summary" />
                            </ui:VisualElement>
                            <ui:VisualElement class="ptv-button-row ptv-button-row--header">
                                <ui:Button name="includeAllButton" text="Include Valid" />
                                <ui:Button name="excludeWarningsButton" text="Exclude Warnings" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="ptv-section__body">
                            <ui:VisualElement name="pagination" class="ptv-pagination ptv-hidden">
                                <ui:Button name="previousPageButton" text="Previous" />
                                <ui:Label name="pageLabel" text="1 / 1" class="ptv-pagination__label" />
                                <ui:Button name="nextPageButton" text="Next" />
                            </ui:VisualElement>
                            <ui:VisualElement name="analysisList" class="ptv-analysis-list" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Foldout name="historyFoldout" text="Generation History" value="false" class="ptv-section ptv-history">
                        <ui:Label name="historySummaryLabel" class="ptv-history__summary" />
                        <ui:VisualElement name="historyList" class="ptv-history-list" />
                        <ui:Button name="selectGroupButton" text="Select Group Asset" />
                    </ui:Foldout>
                </ui:VisualElement>
            </ui:ScrollView>

            <ui:VisualElement class="ptv-preview-pane">
                <ui:VisualElement class="ptv-pane-header">
                    <ui:Label text="Preview" class="ptv-pane-header__title" />
                    <ui:Label name="previewStatusLabel" text="No selection" class="ptv-pane-header__status" />
                </ui:VisualElement>
                <ui:VisualElement name="previewHost" class="ptv-preview-host" />
            </ui:VisualElement>
        </ui:TwoPaneSplitView>

        <ui:VisualElement name="noticePanel" class="ptv-notice-bar ptv-hidden">
            <ui:Label name="noticeLabel" class="ptv-notice-bar__text" />
        </ui:VisualElement>

        <ui:VisualElement class="ptv-actionbar">
            <ui:Label text="Analyze after changing sources or settings." class="ptv-actionbar__hint" />
            <ui:VisualElement class="ptv-actionbar__spacer" />
            <ui:Button name="analyzeButton" text="Analyze Inputs" class="ptv-actionbar__button" />
            <ui:Button name="generateButton" text="Generate Selected" class="ptv-actionbar__button ptv-actionbar__button--primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
