.ptv-window {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-color: var(--unity-colors-default-background);
    color: var(--unity-colors-default-text);
}

.ptv-header {
    min-height: 72px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 18px;
    padding-right: 18px;
    background-color: var(--unity-colors-default-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.ptv-header__icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    margin-right: 12px;
}

.ptv-header__title {
    flex-shrink: 0;
    color: var(--unity-colors-default-text);
    -unity-font-style: bold;
    font-size: 22px;
}

.ptv-header__divider {
    width: 1px;
    height: 34px;
    flex-shrink: 0;
    margin-left: 18px;
    margin-right: 18px;
    background-color: var(--unity-colors-default-border);
}

.ptv-header__subtitle {
    color: var(--unity-colors-label-text);
    font-size: 14px;
}

.ptv-header__spacer {
    flex-grow: 1;
}

.ptv-working {
    flex-shrink: 0;
    color: var(--unity-colors-link-text);
    font-size: 11px;
}

.ptv-scroll {
    flex-grow: 1;
    min-height: 0;
}

.ptv-content {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 4px;
}

.ptv-card {
    margin-bottom: 12px;
    background-color: var(--unity-colors-box-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-radius: 4px;
}

.ptv-card__header {
    min-height: 38px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 12px;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-toolbar-border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

.ptv-card__title {
    flex-grow: 1;
    color: var(--unity-colors-default-text);
    -unity-font-style: bold;
    font-size: 16px;
}

.ptv-pill {
    min-width: 68px;
    min-height: 24px;
    flex-shrink: 0;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 3px;
    background-color: var(--unity-colors-input_field-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-radius: 12px;
    -unity-text-align: middle-center;
    font-size: 11px;
}

.ptv-card__body {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.ptv-fields {
    min-width: 0;
    flex-grow: 1;
}

.ptv-field {
    min-height: 21px;
    flex-shrink: 0;
    margin-top: 1px;
    margin-bottom: 2px;
}

.ptv-field > .unity-base-field__label,
.ptv-field > .unity-property-field__label {
    min-width: 120px;
    color: var(--unity-colors-label-text);
}

.ptv-field > .unity-base-field__input {
    min-width: 0;
}

.ptv-source-list {
    margin-bottom: 8px;
}

.ptv-drop-zone {
    min-height: 94px;
    align-items: center;
    justify-content: center;
    background-color: var(--unity-colors-input_field-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-radius: 3px;
}

.ptv-drop-zone--active {
    background-color: var(--unity-colors-highlight-background-hover);
    border-left-color: var(--unity-colors-input_field-border-focus);
    border-right-color: var(--unity-colors-input_field-border-focus);
    border-top-color: var(--unity-colors-input_field-border-focus);
    border-bottom-color: var(--unity-colors-input_field-border-focus);
}

.ptv-drop-zone__title {
    color: var(--unity-colors-default-text);
    -unity-font-style: bold;
    font-size: 14px;
}

.ptv-drop-zone__hint {
    margin-top: 4px;
    color: var(--unity-colors-label-text);
    font-size: 10px;
}

.ptv-button-row {
    flex-direction: row;
    align-items: center;
    margin-top: 9px;
}

.ptv-button-row > Button {
    min-height: 28px;
    flex-grow: 1;
    margin-right: 4px;
    margin-left: 4px;
}

.ptv-button-row--compact {
    justify-content: flex-end;
    margin-top: 4px;
}

.ptv-button-row--compact > Button {
    min-height: 21px;
    flex-grow: 0;
}

.ptv-advanced {
    margin-top: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-radius: 3px;
}

.ptv-advanced > .unity-foldout__toggle {
    min-height: 28px;
    background-color: var(--unity-colors-toolbar-background);
    -unity-font-style: bold;
}

.ptv-advanced > .unity-foldout__content {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 10px;
}

.ptv-advanced__section {
    margin-bottom: 10px;
    padding-bottom: 9px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.ptv-subheading {
    margin-bottom: 5px;
    color: var(--unity-colors-default-text);
    -unity-font-style: bold;
    font-size: 11px;
}

.ptv-inline-notice,
.ptv-inline-help {
    margin-top: 5px;
    color: var(--unity-colors-label-text);
    font-size: 10px;
    white-space: normal;
}

.ptv-detail-foldout {
    margin-top: 5px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.ptv-detail-foldout > .unity-foldout__toggle {
    min-height: 24px;
    -unity-font-style: bold;
}

.ptv-detail-foldout > .unity-foldout__content {
    padding-left: 8px;
    padding-right: 4px;
    padding-top: 5px;
    padding-bottom: 7px;
}

.ptv-results {
    margin-top: 10px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: var(--unity-colors-default-border);
}

.ptv-results__header {
    min-width: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.ptv-results__heading {
    min-width: 150px;
    flex-grow: 1;
}

.ptv-results__summary {
    color: var(--unity-colors-label-text);
    font-size: 9px;
}

.ptv-pagination {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 6px;
    margin-bottom: 6px;
}

.ptv-pagination__label {
    min-width: 52px;
    -unity-text-align: middle-center;
    font-size: 10px;
}

.ptv-analysis-card {
    margin-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: var(--unity-colors-default-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
}

.ptv-analysis-card__top {
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.ptv-analysis-card__toggle {
    flex-shrink: 0;
    margin-right: 4px;
}

.ptv-analysis-card__source {
    min-width: 80px;
    flex-grow: 1;
    margin-right: 5px;
}

.ptv-status {
    min-width: 44px;
    flex-shrink: 0;
    margin-right: 4px;
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ptv-status--ready {
    color: var(--unity-colors-link-text);
}

.ptv-status--warning {
    color: var(--unity-colors-warning-text);
}

.ptv-status--error {
    color: rgb(224, 91, 91);
}

.ptv-analysis-card__stats {
    margin-top: 5px;
    font-size: 10px;
    white-space: normal;
}

.ptv-analysis-card__size,
.ptv-analysis-card__result,
.ptv-history__summary,
.ptv-history-row__stats {
    margin-top: 2px;
    color: var(--unity-colors-label-text);
    font-size: 9px;
    white-space: normal;
}

.ptv-analysis-help {
    margin-top: 5px;
}

.ptv-history-row {
    min-height: 24px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.ptv-history-row__asset {
    min-width: 160px;
    flex-grow: 1;
    margin-right: 7px;
}

.ptv-notice-bar {
    min-height: 28px;
    flex-shrink: 0;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: var(--unity-colors-helpbox-background);
    border-top-width: 1px;
    border-top-color: var(--unity-colors-helpbox-border);
    border-left-width: 3px;
    border-left-color: var(--unity-colors-link-text);
}

.ptv-notice-bar__text {
    color: var(--unity-colors-helpbox-text);
    font-size: 10px;
    white-space: normal;
}

.ptv-banner--success {
    background-color: rgba(48, 145, 82, 0.18);
    border-left-color: rgb(74, 180, 108);
}

.ptv-banner--error {
    background-color: rgba(185, 60, 60, 0.18);
    border-left-color: rgb(224, 91, 91);
}

.ptv-footer {
    min-height: 94px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 9px;
    padding-bottom: 9px;
    background-color: var(--unity-colors-box-background);
    border-top-width: 1px;
    border-top-color: var(--unity-colors-default-border);
}

.ptv-footer__preview {
    width: 104px;
    height: 74px;
    flex-shrink: 0;
    overflow: hidden;
    background-color: rgb(31, 31, 31);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-radius: 4px;
}

.ptv-preview {
    flex-grow: 1;
}

.ptv-footer__divider {
    width: 1px;
    height: 58px;
    flex-shrink: 0;
    margin-left: 12px;
    margin-right: 14px;
    background-color: var(--unity-colors-default-border);
}

.ptv-footer__status {
    min-width: 120px;
    flex-grow: 1;
    margin-right: 12px;
    color: var(--unity-colors-label-text);
    font-size: 12px;
    white-space: normal;
}

.ptv-footer__button {
    width: 132px;
    min-height: 42px;
    flex-shrink: 0;
    margin-left: 8px;
    -unity-font-style: bold;
    font-size: 14px;
}

.ptv-footer__button--primary,
.ptv-button--primary {
    background-color: var(--unity-colors-highlight-background);
    color: white;
}

.ptv-footer__button--primary:hover,
.ptv-button--primary:hover {
    background-color: var(--unity-colors-highlight-background-hover);
}

.ptv-footer__button--primary:disabled {
    background-color: var(--unity-colors-button-background);
    color: var(--unity-colors-label-text);
}

.ptv-button {
    min-height: 20px;
}

.ptv-inspector {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
}

.ptv-hidden {
    display: none;
}
