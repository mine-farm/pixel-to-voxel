.ptv-window {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-color: var(--unity-colors-default-background);
    color: var(--unity-colors-default-text);
}

.ptv-toolbar {
    height: 24px;
    min-height: 24px;
    flex-shrink: 0;
    align-items: center;
    padding-left: 5px;
    padding-right: 4px;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-toolbar-border);
}

.ptv-toolbar__label {
    flex-shrink: 0;
    margin-right: 6px;
    color: var(--unity-colors-label-text);
    -unity-font-style: bold;
    font-size: 11px;
}

.ptv-toolbar__field {
    min-width: 140px;
    max-width: 360px;
    height: 20px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 3px;
}

.ptv-toolbar__field > .unity-base-field {
    min-width: 0;
    height: 20px;
    flex-grow: 1;
    margin-top: 0;
    margin-bottom: 0;
}

.ptv-toolbar__field > .unity-base-field > .unity-base-field__label {
    display: none;
}

.ptv-toolbar__field > .unity-base-field > .unity-base-field__input {
    min-width: 0;
    height: 18px;
}

.ptv-toolbar__spacer {
    flex-grow: 1;
    min-width: 4px;
}

.ptv-toolbar__button {
    height: 19px;
    min-height: 19px;
    flex-shrink: 0;
    margin-left: 2px;
    padding-left: 8px;
    padding-right: 8px;
}

.ptv-working {
    flex-shrink: 0;
    margin-left: 6px;
    margin-right: 3px;
    color: var(--unity-colors-link-text);
    font-size: 10px;
}

.ptv-info-strip {
    min-height: 31px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: var(--unity-colors-helpbox-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-helpbox-border);
}

.ptv-info-strip__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 7px;
    border-radius: 9px;
    background-color: var(--unity-colors-highlight-background);
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ptv-info-strip__text {
    flex-grow: 1;
    color: var(--unity-colors-helpbox-text);
    font-size: 11px;
    white-space: normal;
}

.ptv-split {
    flex-grow: 1;
    min-height: 0;
}

.ptv-settings-scroll {
    min-width: 300px;
    flex-grow: 1;
}

.ptv-settings-content {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 12px;
}

.ptv-heading {
    margin-bottom: 8px;
    padding-left: 2px;
    padding-right: 2px;
}

.ptv-heading__title {
    color: var(--unity-colors-default-text);
    -unity-font-style: bold;
    font-size: 15px;
}

.ptv-heading__description {
    margin-top: 2px;
    color: var(--unity-colors-label-text);
    opacity: 0.72;
    font-size: 11px;
    white-space: normal;
}

.ptv-section {
    margin-bottom: 8px;
    background-color: var(--unity-colors-box-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-radius: 3px;
}

.ptv-section__header {
    min-height: 25px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 7px;
    padding-right: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-toolbar-border);
}

.ptv-section__header--wrap {
    min-height: 31px;
    flex-wrap: wrap;
}

.ptv-section__heading {
    flex-grow: 1;
    min-width: 140px;
}

.ptv-section__title {
    color: var(--unity-colors-default-text);
    -unity-font-style: bold;
    font-size: 11px;
}

.ptv-section__meta,
.ptv-section__summary {
    color: var(--unity-colors-label-text);
    opacity: 0.68;
    font-size: 9px;
}

.ptv-section__summary {
    margin-top: 1px;
}

.ptv-section__body {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 7px;
    padding-bottom: 8px;
}

.ptv-fields {
    flex-grow: 1;
    min-width: 0;
}

.ptv-field {
    min-height: 20px;
    flex-shrink: 0;
    margin-top: 1px;
    margin-bottom: 1px;
}

.ptv-field > .unity-base-field__label,
.ptv-field > .unity-property-field__label {
    min-width: 120px;
    color: var(--unity-colors-label-text);
}

.ptv-field > .unity-base-field__input {
    min-width: 0;
}

.ptv-sources-field {
    margin-bottom: 4px;
}

.ptv-button-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    margin-top: 4px;
}

.ptv-button-row > Button {
    min-height: 20px;
    margin-left: 4px;
}

.ptv-button-row--header {
    flex-grow: 0;
    margin-top: 0;
}

.ptv-settings-foldout {
    margin-top: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
}

.ptv-settings-foldout > .unity-foldout__toggle {
    min-height: 22px;
    background-color: var(--unity-colors-toolbar-background);
    -unity-font-style: bold;
}

.ptv-settings-foldout > .unity-foldout__content {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 6px;
}

.ptv-output-path,
.ptv-inline-help {
    margin-top: 4px;
    color: var(--unity-colors-label-text);
    opacity: 0.72;
    font-size: 10px;
    white-space: normal;
}

.ptv-drop-zone {
    min-height: 54px;
    align-items: center;
    justify-content: center;
    margin-top: 7px;
    background-color: var(--unity-colors-input_field-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-radius: 3px;
}

.ptv-drop-zone--active {
    background-color: var(--unity-colors-highlight-background-hover);
    border-left-color: var(--unity-colors-input_field-border-focus);
    border-right-color: var(--unity-colors-input_field-border-focus);
    border-top-color: var(--unity-colors-input_field-border-focus);
    border-bottom-color: var(--unity-colors-input_field-border-focus);
}

.ptv-drop-zone__title {
    color: var(--unity-colors-default-text);
    -unity-font-style: bold;
    font-size: 11px;
}

.ptv-drop-zone__hint {
    margin-top: 2px;
    color: var(--unity-colors-label-text);
    opacity: 0.7;
    font-size: 10px;
}

.ptv-preview-pane {
    min-width: 220px;
    min-height: 0;
    flex-grow: 1;
    background-color: var(--unity-colors-default-background);
}

.ptv-pane-header {
    height: 27px;
    min-height: 27px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 7px;
    padding-right: 7px;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-toolbar-border);
}

.ptv-pane-header__title {
    flex-grow: 1;
    color: var(--unity-colors-default-text);
    -unity-font-style: bold;
    font-size: 11px;
}

.ptv-pane-header__status {
    max-width: 180px;
    color: var(--unity-colors-label-text);
    opacity: 0.72;
    font-size: 9px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.ptv-preview-host {
    min-height: 240px;
    flex-grow: 1;
    overflow: hidden;
    background-color: rgb(31, 31, 31);
}

.ptv-preview {
    flex-grow: 1;
}

.ptv-notice-bar {
    min-height: 29px;
    flex-shrink: 0;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: var(--unity-colors-helpbox-background);
    border-top-width: 1px;
    border-top-color: var(--unity-colors-helpbox-border);
    border-left-width: 3px;
    border-left-color: var(--unity-colors-link-text);
}

.ptv-notice-bar__text {
    color: var(--unity-colors-helpbox-text);
    font-size: 10px;
    white-space: normal;
}

.ptv-banner--success {
    background-color: rgba(48, 145, 82, 0.18);
    border-left-color: rgb(74, 180, 108);
}

.ptv-banner--error {
    background-color: rgba(185, 60, 60, 0.18);
    border-left-color: rgb(224, 91, 91);
}

.ptv-actionbar {
    min-height: 35px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 7px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: var(--unity-colors-toolbar-background);
    border-top-width: 1px;
    border-top-color: var(--unity-colors-toolbar-border);
}

.ptv-actionbar__hint {
    min-width: 100px;
    flex-shrink: 1;
    color: var(--unity-colors-label-text);
    opacity: 0.7;
    font-size: 10px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.ptv-actionbar__spacer {
    flex-grow: 1;
}

.ptv-actionbar__button {
    min-width: 105px;
    min-height: 23px;
    flex-shrink: 0;
    margin-left: 4px;
}

.ptv-actionbar__button--primary,
.ptv-button--primary {
    background-color: var(--unity-colors-highlight-background);
    color: white;
}

.ptv-actionbar__button--primary:hover,
.ptv-button--primary:hover {
    background-color: var(--unity-colors-highlight-background-hover);
}

.ptv-actionbar__button--primary:disabled {
    background-color: var(--unity-colors-button-background);
    color: var(--unity-colors-label-text);
    opacity: 0.55;
}

.ptv-pagination {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
}

.ptv-pagination__label {
    min-width: 54px;
    -unity-text-align: middle-center;
    font-size: 10px;
}

.ptv-analysis-card {
    margin-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: var(--unity-colors-default-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-radius: 2px;
}

.ptv-analysis-card__top {
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.ptv-analysis-card__toggle {
    flex-shrink: 0;
    margin-right: 4px;
}

.ptv-analysis-card__source {
    min-width: 80px;
    flex-grow: 1;
    margin-right: 5px;
}

.ptv-status {
    min-width: 44px;
    flex-shrink: 0;
    margin-right: 4px;
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ptv-status--ready {
    color: var(--unity-colors-link-text);
}

.ptv-status--warning {
    color: var(--unity-colors-warning-text);
}

.ptv-status--error {
    color: rgb(224, 91, 91);
}

.ptv-analysis-card__stats {
    margin-top: 5px;
    color: var(--unity-colors-default-text);
    font-size: 10px;
    white-space: normal;
}

.ptv-analysis-card__size,
.ptv-analysis-card__result {
    margin-top: 2px;
    color: var(--unity-colors-label-text);
    opacity: 0.72;
    font-size: 9px;
    white-space: normal;
}

.ptv-analysis-help {
    margin-top: 5px;
}

.ptv-history > .unity-foldout__toggle {
    min-height: 26px;
    padding-left: 5px;
    background-color: var(--unity-colors-toolbar-background);
    -unity-font-style: bold;
}

.ptv-history > .unity-foldout__content {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 8px;
}

.ptv-history__summary {
    margin-bottom: 5px;
    color: var(--unity-colors-label-text);
    opacity: 0.72;
    font-size: 10px;
    white-space: normal;
}

.ptv-history-row {
    min-height: 24px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 3px;
    padding-left: 4px;
    padding-right: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.ptv-history-row__asset {
    min-width: 160px;
    flex-grow: 1;
    margin-right: 7px;
}

.ptv-history-row__stats {
    color: var(--unity-colors-label-text);
    opacity: 0.72;
    font-size: 9px;
}

.ptv-button {
    min-height: 20px;
}

.ptv-inspector {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
}

.ptv-hidden {
    display: none;
}
